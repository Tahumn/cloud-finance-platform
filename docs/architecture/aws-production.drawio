        <mxCell id="gemini" value="External LLM API&#xa;Gemini (current code)&#xa;&#xa;Amazon Bedrock is a future migration option, not a current dependency." style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#5F6368;fillColor=#F1F3F4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1845" y="150" width="450" height="125" as="geometry"/></mxCell>
        <mxCell id="cicd" value="CI/CD&#xa;&#xa;GitHub Actions&#xa;→ OIDC IAM role&#xa;→ Amazon ECR&#xa;→ Amazon ECS rolling deployment" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#ED7100;fillColor=#FFF3E8;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1845" y="330" width="450" height="175" as="geometry"/></mxCell>
        <mxCell id="legend" value="CONNECTOR LEGEND&#xa;&#xa;Blue solid — HTTPS / request-response&#xa;Black solid — internal REST / database&#xa;Orange dashed — queue / deployment&#xa;Green dashed — external integration" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#B7A400;fillColor=#FFF8B5;fontStyle=1;fontSize=14;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1845" y="570" width="450" height="170" as="geometry"/></mxCell>
        <mxCell id="notes" value="DEPLOYMENT NOTES&#xa;&#xa;• No Cognito: Auth Service owns JWT/OTP.&#xa;• No API Gateway: ALB targets FastAPI Gateway.&#xa;• No Lambda OCR: OCR runs as an ECS service.&#xa;• No SQS in baseline: worker currently uses Redis.&#xa;• One NAT Gateway for demo cost; production HA uses one per AZ.&#xa;• Logical database ownership on shared RDS; split instances later if required." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#147EBA;fillColor=#E7F3F8;fontSize=14;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1845" y="800" width="450" height="250" as="geometry"/></mxCell>

